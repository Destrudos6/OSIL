---
// Agent 控制台示意（Hero 下方的大图）
import Sidebar from './Sidebar.astro';
import TopBar from './TopBar.astro';
import KpiCard from './KpiCard.astro';
import Panel from './Panel.astro';
import Segmented from '../ui/Segmented.astro';
import ActivityChart from './ActivityChart.astro';
import TaskList from './TaskList.astro';
import LiveLog from './LiveLog.astro';
import { consoleDemo as d } from '../../data/home';
---
<div class="console" aria-label={d.ariaLabel}>
  <Sidebar agents={d.agents} brand={d.brand} menu={d.menu} agentsHeading={d.agentsHeading} status={{ all: d.statusAll, updated: d.statusUpdated }} />
  <div class="main">
    <TopBar title={d.title} subtitle={d.subtitle} search={d.search} searchKey={d.searchKey} avatar={d.avatar} />
    <div class="kpis">{d.kpis.map((k) => <KpiCard {...k} />)}</div>
    <div class="grid2">
      <Panel title={d.panels.activity.title} desc={d.panels.activity.desc}><Segmented slot="actions" options={d.ranges} />
        <ActivityChart legend={d.legend} /></Panel>
      <Panel title={d.panels.tasks.title} desc={d.panels.tasks.desc}>
        <TaskList tasks={d.tasks} statusLabels={d.taskStatus} />
        <LiveLog lines={d.log} />
      </Panel>
    </div>
  </div>
</div>
<style>
.console{border:1px solid var(--line);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-lg);overflow:hidden;text-align:left;display:grid;grid-template-columns:210px 1fr;min-height:520px}
.main{padding:16px 20px 20px;display:flex;flex-direction:column;gap:14px;min-width:0}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.grid2{display:grid;grid-template-columns:1.25fr 1fr;gap:10px;flex:1;min-height:0}
@media (max-width:960px){.console{grid-template-columns:1fr}.grid2{grid-template-columns:1fr}}
@media (max-width:640px){.kpis{grid-template-columns:repeat(2,1fr)}}
</style>
