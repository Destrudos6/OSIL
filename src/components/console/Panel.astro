---
// 控制台里的小面板：标题 + 说明 + 右侧可选插槽
interface Props { title: string; desc?: string }
const { title, desc } = Astro.props;
---
<div class="panel">
  <div class="ph"><div><h4>{title}</h4>{desc && <p>{desc}</p>}</div><slot name="actions" /></div>
  <slot />
</div>
<style>
.panel{border:1px solid var(--line);border-radius:10px;padding:12px;display:flex;flex-direction:column;min-width:0}
.ph{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px}
h4{font-size:12.5px;font-weight:600}
.ph p{font-size:10.5px;color:var(--muted)}
</style>
