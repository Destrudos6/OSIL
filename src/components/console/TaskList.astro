---
interface Task { icon: string; title: string; agent: string; status: string }
interface Props { tasks: readonly Task[]; statusLabels: Record<string, string> }
const { tasks, statusLabels } = Astro.props;
---
<div class="tasks">
  {tasks.map((t) => (
    <div class="task"><span class="ic">{t.icon}</span><div class="tx"><b>{t.title}</b><span>{t.agent}</span></div><span class:list={['chip', { run: t.status === 'run' }]}>{statusLabels[t.status] ?? t.status}</span></div>
  ))}
</div>
<style>
.tasks{display:flex;flex-direction:column}
.task{display:flex;align-items:center;gap:10px;padding:8px 2px;border-top:1px solid var(--line2)}
.task:first-child{border-top:0}
.ic{width:26px;height:26px;border-radius:7px;background:var(--bg-soft);border:1px solid var(--line);display:grid;place-items:center;flex:none;font-family:var(--mono);font-size:10px;color:var(--fg2)}
.tx{min-width:0;flex:1}
.tx b{display:block;font-size:12px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tx span{font-size:10.5px;color:var(--muted)}
.chip{font-size:10px;font-weight:500;border:1px solid var(--line);border-radius:5px;padding:1px 6px;color:var(--muted);flex:none}
.chip.run{color:var(--blue);border-color:color-mix(in srgb,var(--blue) 35%,transparent)}
.chip.run:before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--blue);margin-right:4px;vertical-align:1px;animation:blink 1s infinite}
</style>
