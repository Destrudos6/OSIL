---
interface Props { title: string; subtitle: string; search: string; searchKey: string; avatar: string }
const { title, subtitle, search, searchKey, avatar } = Astro.props;
---
<div class="top">
  <div><h3>{title}</h3><p>{subtitle}</p></div>
  <div class="search"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5 14 14"/></svg>{search}<kbd>{searchKey}</kbd></div>
  <span class="av">{avatar}</span>
</div>
<style>
.top{display:flex;align-items:center;gap:12px}
h3{font-size:14px;font-weight:600;letter-spacing:-.01em}
p{font-size:11px;color:var(--muted)}
.search{margin-left:auto;display:flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:8px;padding:5px 10px;font-size:11.5px;color:var(--muted);width:180px}
kbd{margin-left:auto;font-family:var(--mono);font-size:10px;border:1px solid var(--line);border-radius:4px;padding:0 4px}
.av{width:28px;height:28px;border-radius:50%;background:var(--fg);color:var(--bg);display:grid;place-items:center;font-size:10.5px;font-weight:600}
@media (max-width:640px){.search{display:none}}
</style>
