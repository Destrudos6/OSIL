---
// Agent 活动折线图（客户端绘制的演示数据）；图例文字/颜色来自 consoleDemo.legend
interface Props { legend: readonly { label: string; color: string }[] }
const { legend } = Astro.props;
---
<div class="chart"><svg viewBox="0 0 400 160" preserveAspectRatio="none" data-chart></svg></div>
<div class="legend">{legend.map((l) => <span><i style={`background:${l.color}`}></i>{l.label}</span>)}</div>
<style>
.chart{flex:1;min-height:150px}
svg{width:100%;height:100%;display:block}
.legend{display:flex;gap:14px;font-size:10.5px;color:var(--muted);margin-top:6px}
.legend i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:5px;vertical-align:-1px}
</style>
<script>
  document.querySelectorAll<SVGSVGElement>('[data-chart]').forEach((svg) => {
    const W = 400, H = 160, n = 24, a: number[] = [], b: number[] = [];
    for (let i = 0; i < n; i++) { const base = 40 + 30 * Math.sin(i / 3.2) + i * 2.2; b.push(base + 12 + ((i * 37) % 11)); a.push(base + ((i * 53) % 9) - 4); }
    const mx = Math.max(...b) + 14, x = (i: number) => i * (W / (n - 1)), y = (v: number) => H - 8 - (v / mx) * (H - 20);
    const path = (arr: number[]) => arr.map((v, i) => (i ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(v).toFixed(1)).join(' ');
    let g = ''; for (let i = 1; i < 4; i++) g += `<line x1="0" x2="${W}" y1="${i * H / 4}" y2="${i * H / 4}" stroke="var(--line)" stroke-dasharray="3 4"/>`;
    svg.innerHTML = `${g}<defs><linearGradient id="ga" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--blue)" stop-opacity=".18"/><stop offset="1" stop-color="var(--blue)" stop-opacity="0"/></linearGradient></defs>
<path d="${path(b)} L${W} ${H} L0 ${H}Z" fill="url(#ga)"/><path class="ln" d="${path(b)}" fill="none" stroke="var(--blue)" stroke-width="1.6" vector-effect="non-scaling-stroke"/><path class="ln" d="${path(a)}" fill="none" stroke="var(--fg)" stroke-width="1.6" vector-effect="non-scaling-stroke"/>`;
    svg.querySelectorAll<SVGPathElement>('.ln').forEach((p) => {
      const L = p.getTotalLength(); p.style.strokeDasharray = `${L}`; p.style.strokeDashoffset = `${L}`; p.style.transition = 'stroke-dashoffset 2s ease .4s';
      requestAnimationFrame(() => requestAnimationFrame(() => (p.style.strokeDashoffset = '0')));
    });
  });
</script>
