---
// 品牌图标（黑底圆环）
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<span class="mark" style={`--s:${size}px`}></span>
<style>
.mark{width:var(--s);height:var(--s);border-radius:calc(var(--s) * .27);background:var(--fg);display:inline-grid;place-items:center;flex:none}
.mark:after{content:"";width:calc(var(--s) * .41);height:calc(var(--s) * .41);border-radius:50%;border:2px solid var(--bg);box-shadow:inset 0 0 0 1.5px var(--blue)}
</style>
