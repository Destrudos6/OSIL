---
// 区块标题：可选 eyebrow、标题（支持 <b> 强调）、副标题
import Eyebrow from './Eyebrow.astro';
interface Props { eyebrow?: string; title: string; sub?: string; align?: 'left' | 'center'; maxWidth?: string; reveal?: boolean }
const { eyebrow, title, sub, align = 'left', maxWidth, reveal = true } = Astro.props;
---
<div class:list={['head', align, { rv: reveal }]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 class="h2 serif" style={maxWidth ? `max-width:${maxWidth}` : undefined} set:html={title} />
  {sub && <p class="sub">{sub}</p>}
  <slot />
</div>
<style>
.head :global(.eyebrow) + h2{margin-top:14px}
.center{text-align:center}
.center h2,.center .sub{margin-left:auto;margin-right:auto}
</style>
